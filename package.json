{
  "name": "boozeonhormuz-com",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:output": "node scripts/check-output.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:fixtures": "node scripts/verify-fixtures.mjs",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci autorun",
    "verify": "npm run check && npm run test:unit && npm run test:fixtures && npm run build && npm run check:media && npm run check:output && npm run test:e2e",
    "media:generate": "node scripts/generate-media.mjs",
    "predev": "npm run media:generate",
    "prebuild": "npm run media:generate",
    "check:media": "node scripts/verify-media.mjs"
  },
  "dependencies": {
    "@astro-community/astro-embed-youtube": "0.5.10",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/fraunces": "5.2.9",
    "@fontsource-variable/inter": "5.2.8",
    "@tailwindcss/vite": "4.2.0",
    "astro": "6.4.2",
    "astro-og-canvas": "0.11.1",
    "tailwindcss": "4.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "typescript": "6.0.3",
    "sharp": "0.34.5"
  }
}
