{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/",
        "http://localhost/album/",
        "http://localhost/watch/",
        "http://localhost/watch/the-premiere/",
        "http://localhost/listen/",
        "http://localhost/archive/",
        "http://localhost/play/",
        "http://localhost/tools/broadcast-room/",
        "http://localhost/tools/evidence-lounge-studio/",
        "http://localhost/apps/broadcast-room.html",
        "http://localhost/apps/evidence-lounge-studio.html",
        "http://localhost/apps/exit-strategy.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 1,
          "disabled": false
        },
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^https?://[^/]+/(?:[?#].*)?$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:best-practices": [
              "warn",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 3300
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200
              }
            ]
