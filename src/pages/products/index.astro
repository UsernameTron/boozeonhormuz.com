---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';

import MediaThumb from '../../components/MediaThumb.astro';

interface Product {
  name: string;
  image: string;
  alt: string;
  featured?: boolean;
  price?: string;
  note?: string;
  pitch?: string;
}

const products: Product[] = [
  {
    name: 'Captain Crunk Cereal',
    image: '/products/captain-crunk-cereal.webp',
    alt: 'Red Captain Crunk cereal box showing Don Biggly in a feathered naval hat offering a spoon above a bowl of golden cereal.',
    featured: true,
    price: 'Breakfast included*',
    note: '*The cereal is free. Milk is a leadership consulting fee.',
    pitch: 'Other cereals give kids a toy. Mine gives them a waiver. They can play with it after their parents sign.',
  },
  {
    name: 'The Hormuz Decanter',
    image: '/products/hormuz-decanter.webp',
    alt: 'Crystal ship-shaped Hormuz Decanter with a resort on one shore and ruins on the other.',
    price: '$14,000',
    note: 'Holds exactly one regret. Not for sale, obviously.',
  },
  {
    name: 'Discovery-Proof Briefcase',
    image: '/products/discovery-proof-briefcase.webp',
    alt: 'Black leather Discovery-Proof Briefcase stamped Exhibit A, with a subpoena sticking out.',
    price: 'Inquire discreetly',
    note: 'Lock not included. Neither is the alibi.',
  },
  {
    name: 'Premium Panic Cufflinks',
    image: '/products/premium-panic-cufflinks.webp',
    alt: 'Gold Premium Panic Cufflinks holding miniature lifeboats in an open presentation case.',
    note: 'As seen sweating on every lawyer in the room.',
  },
  {
    name: 'Legal Disclaimer Cologne',
    image: '/products/legal-disclaimer-cologne.webp',
    alt: 'Black and gold Legal Disclaimer Cologne bottle spraying a cloud of redacted text.',
    price: 'Priceless (allegedly)',
    note: 'Top notes of subpoena. Dries down to plausible deniability.',
  },
];
---

<BaseLayout title="Products | Booze on Hormuz™" description="Premium amenities for the discerning crisis.">
  <PageHeader eyebrow="The collection" title="Products" />

  <section class="px-6 pb-28 max-w-4xl mx-auto">
    <p class="font-display text-title text-ink max-w-2xl">
      The collection is in private preview. Nothing is available for purchase, which is for the best.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-10">
      {
        products.map((p) => (
          <article class:list={['card-marble border border-line rounded-xl overflow-hidden shadow-lg', p.featured && 'sm:col-span-2 sm:grid sm:grid-cols-2']}>
            <MediaThumb src={p.image} alt={p.alt} aspect={p.featured ? 'aspect-[4/5]' : 'aspect-square'} fit="contain" />

            <div class:list={['p-4', p.featured && 'sm:p-8 sm:flex sm:flex-col sm:justify-end']}>
              {p.featured && <p class="font-body text-eyebrow uppercase text-gold-ink mb-3">The breakfast program</p>}
              <h3 class="font-display text-title text-ink">{p.name}</h3>
              {p.price && <p class="font-body text-gold-ink mt-1">{p.price}</p>}
              {p.note && <p class="font-body text-sm text-ink-soft/80 mt-1 italic">{p.note}</p>}
              {p.pitch && <p class="font-body text-ink-soft mt-6 max-w-sm">{p.pitch}</p>}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
