---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { episodes } from '../data/mctrumps';
---

<BaseLayout title="McTrumps | Booze on Hormuz™" description="McTrumps company videos now have their own page." canonicalPath="/mctrumps/">
  <PageHeader eyebrow="The new address" title="McTrumps" />
  <section class="px-6 pb-16 max-w-4xl mx-auto font-body">
    <p class="text-ink-soft">McTrumps now has its own page. Open the company videos or choose one below.</p>
    <a href="/mctrumps/" class="inline-flex min-h-11 items-center text-gold-ink hover:underline mt-4">Open McTrumps →</a>
    <nav aria-label="McTrumps videos" class="mt-6">
      <ul class="space-y-2">
        {episodes.map((episode) => (
          <li><a href={`/mctrumps/#${episode.id}`} class="inline-flex min-h-11 items-center text-gold-ink hover:underline">{episode.title}</a></li>
        ))}
      </ul>
    </nav>
  </section>
  <script is:inline>
    window.location.replace(`/mctrumps/${window.location.search}${window.location.hash}`);
  </script>
</BaseLayout>
