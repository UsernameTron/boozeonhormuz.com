---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/mctrumps.css';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import { episodes, fictionLabel, complaints } from '../data/mctrumps';
const localMedia = (path: string | null) => path && path.startsWith('/') && existsSync(resolve('public', `.${path}`)) ? path : undefined;
---
<BaseLayout title="McTrumps · Sponsor Reads — Booze on Hormuz™" description="Five fictional McTrumps commercials. Don Biggly puts on the clown makeup and takes management personally.">
<div class="mctr">
<section class="mc-hero"><div class="mc-wrap mc-hero-grid"><div>
<p class="mc-eyebrow">Sponsor Reads / A fictional commercial break</p><p class="mc-brand">McTrumps<span>™</span></p>
<h1>Come for the burger.<br/><em>Leave with an indictment.</em></h1>
<p class="mc-intro">Don Biggly has put on the clown makeup. Management considers this a promotion.</p>
<p class="mc-fiction">{fictionLabel}</p>
<div class="mc-actions"><a class="mc-button" href="#welcome">Meet the management <span aria-hidden="true">↓</span></a><a class="mc-link" href="#customer-relations">Speak to the manager</a></div>
<p class="mc-small">Five commercials · 3 minutes 25 seconds · No mandatory ad break.</p>
</div><div class="mc-tray">
<div class="mc-carton mc-host"><img src="/mctrumps/welcome.webp" alt="Don Biggly in red clown makeup, the fictional face of McTrumps" width="720" height="1280" fetchpriority="high"/><p>THE FACE OF CUSTOMER SERVICE</p></div>
</div></div>
<nav class="mc-wrap mc-episode-nav" aria-label="McTrumps episodes">{episodes.map((e,i)=><a href={`#${e.id}`}><span>0{i+1}</span>{e.shortTitle}</a>)}</nav></section>
<section class="mc-programme mc-wrap" aria-labelledby="programme-title">
<div class="mc-heading"><div><p class="mc-eyebrow">The commercial break</p><h2 id="programme-title">Five messages.<br/><em>One conflict of interest.</em></h2></div><p>The welcome. The birthday. The employment record. The bonus. The expansion. Every department reports to the same clown.</p></div>
{episodes.map((e,i)=>{const video=localMedia(e.video);const poster=localMedia(e.poster);return <article id={e.id} class="mc-episode" aria-labelledby={`${e.id}-title`}>
<div class="mc-episode-copy"><p class="mc-eyebrow">Commercial 0{i+1} / {e.department}</p><h3 id={`${e.id}-title`}>{e.title}</h3><p class="mc-premise">{e.synopsis}</p><div class="mc-producer"><span class="mc-eyebrow">The producer’s note</span><p>{e.note}</p></div><a class="mc-link" href={`#${episodes[(i+1)%episodes.length].id}`}>{i===episodes.length-1?'Back to the welcome':'Next commercial'} <span aria-hidden="true">→</span></a></div>
<div class="mc-episode-media">{video?<><video controls playsinline preload="none" src={video} poster={poster} aria-label={`McTrumps: ${e.title}`} style={`aspect-ratio: ${e.ratio}; --mc-video-max-width: ${620 * e.width / e.height}px`} width={e.width} height={e.height}>Your browser does not support video playback. <a href={video}>Open the video</a>.</video><p class="mc-video-error" role="status" hidden>Playback is unavailable. <a href={video}>Open the video directly</a> or read the scene below.</p><p class="mc-small">{e.duration} · Fictional McTrumps commercial · Don Biggly in clown makeup.</p></>:<div class="mc-script-stage"><span class="mc-stage-number" aria-hidden="true">0{i+1}</span><p class="mc-eyebrow">McTrumps / {e.department}</p><p class="mc-stage-line">{e.stageLine}</p><p class="mc-import-status">Video unavailable. Read the scene below.</p></div>}
<details class="mc-reading"><summary>{e.transcript?'Read the interview script':'Read the scene summary'} <span aria-hidden="true">＋</span></summary><div class="mc-reading-body"><p class="mc-fiction">{fictionLabel}</p>{e.transcript?e.transcript.map(p=><p>{p}</p>):<><p>{e.synopsis}</p><p class="mc-small">Creator-described scene. A verbatim transcript will be added from the finished video.</p></>}</div></details>
</div></article>;})}
</section>
<section class="mc-customer" id="customer-relations"><div class="mc-wrap mc-customer-grid"><div><p class="mc-eyebrow">Customer relations</p><h2>Ask for the manager.<br/><em>You already met him.</em></h2><p>Three entirely reasonable questions. Three reasons the franchise no longer takes follow-up questions.</p><p class="mc-fiction">{fictionLabel}</p></div><div class="mc-complaints">{complaints.map(c=><details><summary>{c.question}<span aria-hidden="true">＋</span></summary><div><p class="mc-eyebrow">Don’s response</p><p class="mc-don">{c.don}</p><div class="mc-producer"><span class="mc-eyebrow">The desk note</span><p>{c.note}</p></div></div></details>)}</div></div></section>
<section class="mc-wrap mc-other"><div><p class="mc-eyebrow">Elsewhere in the sponsor file</p><h2>Other excellent<br/><em>conflicts of interest.</em></h2><p>The original fictional sponsors remain in the collection.</p></div><div class="mc-other-list"><p><strong>Hormuz Premium Yacht Fuel</strong><span>Now with extra plausible deniability.</span></p><p><strong>Discovery Shredding Co.</strong><span>Documents handled. Memories discouraged.</span></p><p><strong>Panic Room Realty</strong><span>Square footage for the consequences.</span></p><p><strong>Legal-Ish Insurance Group</strong><span>Covers everything except what actually happened.</span></p></div></section>
<div class="mc-wrap mc-exits"><a href="/experience/">Visit Don’s resort ↗</a><a href="/play/">Try an exit strategy ↗</a><a href="#main-content">Back to the counter ↑</a></div>
<p class="mc-wrap mc-disclosure">McTrumps and Don Biggly are fictional parody. No affiliation with or endorsement by McDonald’s or its characters. No food, consulting, franchises or financial services are offered here.</p>
</div>
</BaseLayout>
<script>
const videos=[...document.querySelectorAll<HTMLVideoElement>('.mctr video')];
videos.forEach(video => {
  video.addEventListener('play', () => videos.forEach(other => { if (other !== video) other.pause(); }));
  video.addEventListener('error', () => {
    const notice = video.parentElement?.querySelector<HTMLElement>('.mc-video-error');
    if (notice) notice.hidden = false;
  });
});
</script>
