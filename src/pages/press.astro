---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import LocalVideo from '../components/LocalVideo.astro';
---

<BaseLayout title="Press | Booze on Hormuz™" description="Don Biggly at the news desk.">
  <PageHeader title="Press" />

  <section class="px-6 pb-28 max-w-4xl mx-auto">
    <LocalVideo
      src="/press/don-biggly-broadcast.mp4"
      poster="/press/don-biggly-broadcast.webp"
      title="Don Biggly news broadcast"
      orientation="9:16"
      videoWidth={480}
      videoHeight={720}
    />
  </section>
</BaseLayout>
