---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import MediaThumb from '../../components/MediaThumb.astro';
import TrackRow from '../../components/TrackRow.astro';
import { listedTracks } from '../../lib/media';

// The album stays visible while the filmed setlist fills in.
const album = (await getCollection('albums')).find((a) => !a.data.draft);
const tracks = listedTracks(await getCollection('tracks'));
const filmedTrackIds = new Set((await getCollection('videos'))
  .filter((video) => !video.data.draft && video.data.type === 'performance' && video.data.track)
  .map((video) => video.data.track!.id));
const filmedCount = tracks.filter((track) => filmedTrackIds.has(track.id)).length;

const statusLabel: Record<string, string> = {
  'in-progress': 'Live Tour in Progress',
  preview: 'Preview',
  released: 'Released',
};
---

<BaseLayout
  title="The Album | Booze on Hormuz™"
  description="Booze on Hormuz is a live video album by Don Biggly & The Indictments. Songs arrive as filmed performances with lyrics on screen."
>
  <PageHeader eyebrow="The main body of work" title="The Album" />

  <section class="px-6 pb-28 max-w-4xl mx-auto">
    {
      album ? (
        <Fragment>
          <div class="grid md:grid-cols-[320px_1fr] gap-8 items-start">
            <div class="border border-line rounded-xl overflow-hidden shadow-lg">
              <MediaThumb src={album.data.artwork} alt={`${album.data.title} album artwork`} aspect={album.data.artwork ? "aspect-square" : "aspect-[3/1]"} fit="contain" sizes="(min-width: 768px) 320px, calc(100vw - 48px)" />
            </div>
            <div>
              <h2 class="font-display text-title text-ink">{album.data.title}</h2>
              {album.data.artist && <p class="font-body text-lg text-ink-soft mt-2">{album.data.artist}</p>}
              <p class="font-body text-eyebrow uppercase text-gold-ink mt-2">
                {statusLabel[album.data.status] ?? album.data.status}
              </p>
              <p class="font-body text-ink-soft mt-4 max-w-prose">{album.data.tagline}</p>
              {filmedCount > 0 && (
                <p class="font-body text-sm text-ink-soft/70 mt-2">
                  {filmedCount} of {tracks.length} song videos live.
                </p>
              )}
              {album.data.credits.length > 0 && (
                <p class="font-body text-sm text-ink-soft/70 mt-4">{album.data.credits.join(' · ')}</p>
              )}
            </div>
          </div>

          <h3 class="font-display text-xl text-ink mt-10 md:mt-14">The Setlist</h3>
          {
            tracks.length > 0 ? (
              <div class="mt-4 card-marble border border-line rounded-xl overflow-hidden">
                {tracks.map((t) => (
                  <TrackRow
                    trackNumber={t.data.trackNumber}
                    title={t.data.title}
                    slug={t.data.slug}
                    status={t.data.status}
                    duration={t.data.duration}
                  />
                ))}
              </div>
            ) : (
              <p class="font-display text-xl text-ink mt-4 max-w-2xl">
                The stage is booked. Don has approved the lighting, the applause, and his own
                entrance. The first filmed song will take its place here when the set begins.
              </p>
            )
          }
        </Fragment>
      ) : (
        <p class="font-display text-title text-ink max-w-2xl">
          The album is in a secure, undisclosed, extremely gold location. Check back shortly.
        </p>
      )
    }
  </section>
</BaseLayout>
