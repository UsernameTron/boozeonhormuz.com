---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaThumb from '../../components/MediaThumb.astro';
import TrackRow from '../../components/TrackRow.astro';
import { listedTracks } from '../../lib/media';

// The album stays visible while the video setlist fills in.
const album = (await getCollection('albums')).find((a) => !a.data.draft);
const tracks = listedTracks(await getCollection('tracks'));
const filmedTrackIds = new Set((await getCollection('videos'))
  .filter((video) => !video.data.draft && video.data.type === 'performance' && video.data.track)
  .map((video) => video.data.track!.id));
const filmedCount = tracks.filter((track) => filmedTrackIds.has(track.id)).length;

const statusLabel: Record<string, string> = {
  'in-progress': 'Live Tour in Progress',
  preview: 'Preview',
  released: 'Released',
};
---

<BaseLayout
  title="The Album | Booze on Hormuz™"
  description="The Booze on Hormuz album by Don Biggly & The Indictments. Every song has a video with lyrics on screen."
>
  <section class="px-6 pt-8 md:pt-10 pb-20 max-w-4xl mx-auto">
    <p class="font-body text-eyebrow uppercase text-gold-ink">The main body of work</p>
    <h1 class="font-display text-title text-ink mt-2">The Album</h1>
    {
      album ? (
        <Fragment>
          <div class="grid grid-cols-[96px_1fr] sm:grid-cols-[152px_1fr] gap-5 items-start mt-5">
            <div class="border border-line rounded-xl overflow-hidden shadow-lg">
              <MediaThumb src={album.data.artwork} alt={`${album.data.title} album artwork`} aspect={album.data.artwork ? "aspect-square" : "aspect-[3/1]"} fit="contain" sizes="(min-width: 640px) 152px, 96px" />
            </div>
            <div>
              <h2 class="font-display text-xl text-ink">{album.data.title}</h2>
              {album.data.artist && <p class="font-body text-sm text-ink-soft mt-1">{album.data.artist}</p>}
              <p class="font-body text-eyebrow uppercase text-gold-ink mt-1">{statusLabel[album.data.status] ?? album.data.status}</p>
              <p class="font-body text-sm text-ink-soft mt-2 max-w-prose">{album.data.tagline}</p>
              {filmedCount > 0 && (
                <p class="font-body text-sm text-ink-soft/70 mt-1">
                  {filmedCount} of {tracks.length} song videos live.
                </p>
              )}
              {album.data.credits.length > 0 && (
                <p class="font-body text-sm text-ink-soft/70 mt-2">{album.data.credits.join(' · ')}</p>
              )}
            </div>
          </div>
          {tracks.length > 0 && <a href="#setlist" class="inline-flex min-h-11 items-center font-body text-sm uppercase tracking-[0.1em] text-gold-ink border border-gold px-5 py-2 rounded-sm mt-5 hover:bg-charcoal transition-colors">Start the setlist &darr;</a>}
          <h3 id="setlist" class="font-display text-xl text-ink mt-6 scroll-mt-6">The Setlist</h3>
          {
            tracks.length > 0 ? (
              <div class="mt-4 card-marble border border-line rounded-xl overflow-hidden">
                {tracks.map((t) => (
                  <TrackRow
                    trackNumber={t.data.trackNumber}
                    title={t.data.title}
                    slug={t.data.slug}
                    status={t.data.status}
                    duration={t.data.duration}
                  />
                ))}
              </div>
            ) : (
              <p class="font-display text-xl text-ink mt-4 max-w-2xl">
                The stage is booked. I approved the lights and my entrance. The first song video
                appears when the set begins.
              </p>
            )
          }
          <aside class="card-marble border border-line rounded-xl p-5 mt-8">
            <h3 class="font-display text-xl text-ink">Beyond the setlist</h3>
            <p class="font-body text-ink-soft mt-2">The setlist ended. I kept the microphone. Counsel calls these extra performances.</p>
            <a href="/deep-cuts/" class="inline-flex min-h-11 items-center text-gold-ink mt-2">Watch Deep Cuts Live →</a>
          </aside>
        </Fragment>
      ) : (
        <p class="font-display text-title text-ink max-w-2xl">
          The album is being prepared. I approved the cover before the songs.
        </p>
      )
    }
  </section>
</BaseLayout>
