---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import LocalVideo from '../../components/LocalVideo.astro';
import MediaThumb from '../../components/MediaThumb.astro';
import { artHref } from '../../lib/archive';
import { mediaImageSource, responsiveImage } from '../../lib/responsive-media';
import WatchCard from '../../components/WatchCard.astro';
import { playableTracks, liveVideos, liveImages, videoTypeLabel } from '../../lib/media';

// A song page leads with its lyric video, then adds any separate audio,
// music video, gallery, and credits that actually exist.
export async function getStaticPaths() {
  const tracks = playableTracks(await getCollection('tracks'));
  const videos = liveVideos(await getCollection('videos'));
  const images = liveImages(await getCollection('images'));
  const albums = (await getCollection('albums')).filter((album) => !album.data.draft);
  return tracks.map((track, index) => ({
    params: { slug: track.data.slug },
    props: {
      track,
      albumArtwork: albums.find((album) => album.id === track.data.album.id)?.data.artwork,
      videos: videos.filter((v) => v.data.track?.id === track.id),
      gallery: images.filter((i) => i.data.track?.id === track.id),
      previous: tracks[index - 1],
      next: tracks[index + 1],
    },
  }));
}

const { track, albumArtwork, videos, gallery, previous, next } = Astro.props;
const { title, trackNumber, status, description, cover, audio, duration, releaseDate, credits, streamingLinks } = track.data;

const musicVideos = videos.filter((v) => v.data.type === 'music-video');
const performances = videos.filter((v) => v.data.type === 'performance');
const primaryVideo = performances[0] ?? musicVideos[0];
const additionalMusicVideos = musicVideos.filter((video) => video.id !== primaryVideo?.id);
const additionalPerformances = performances.filter((video) => video.id !== primaryVideo?.id);
const clips = videos.filter((v) => v.data.type === 'short' || v.data.type === 'sketch');
const date = releaseDate?.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Track body (the short creative note) renders below the player.
const { Content } = await render(track);
const songArtwork = cover ?? albumArtwork;
const socialImage = mediaImageSource(songArtwork);
const socialDimensions = responsiveImage(socialImage);
---

<BaseLayout title={`${title} | Booze on Hormuz™`} description={description ?? `${title}, a song video from the Booze on Hormuz live-tour album.`} ogImage={socialImage} ogImageWidth={socialDimensions.width} ogImageHeight={socialDimensions.height}>
  <article class="px-6 pt-7 md:pt-9 pb-20 max-w-4xl mx-auto">
    <p class="font-body text-eyebrow uppercase text-gold-ink">
      Track {String(trackNumber).padStart(2, '0')}
      {status === 'preview' && <span class="text-ink-soft/70"> · Preview</span>}
      {date && <span class="text-ink-soft/70 normal-case tracking-normal"> · {date}</span>}
    </p>
    <h1 class="font-display text-title text-ink mt-2">{title}</h1>
    {duration && <p class="font-body text-sm text-ink-soft/70 mt-2 tabular-nums">{duration}</p>}

    {primaryVideo && (
      <div class="song-player mt-5">
        {primaryVideo.data.youtubeId ? (
          <YouTubeEmbed id={primaryVideo.data.youtubeId} title={primaryVideo.data.title} poster={primaryVideo.data.poster ?? primaryVideo.data.thumbnail} orientation={primaryVideo.data.orientation} />
        ) : (
          primaryVideo.data.src && <LocalVideo src={primaryVideo.data.src} title={primaryVideo.data.title} poster={primaryVideo.data.poster ?? primaryVideo.data.thumbnail} orientation={primaryVideo.data.orientation} videoWidth={primaryVideo.data.videoWidth} videoHeight={primaryVideo.data.videoHeight} captions={primaryVideo.data.captions} />
        )}
        {primaryVideo.data.transcript && (
          <details class="mt-5 max-w-prose">
            <summary class="font-body text-sm uppercase tracking-[0.1em] text-gold-ink cursor-pointer">Lyrics and transcript</summary>
            <p class="font-body text-sm text-ink-soft whitespace-pre-line mt-3">{primaryVideo.data.transcript}</p>
          </details>
        )}
      </div>
    )}

    <nav aria-label="Album song navigation" class="flex flex-wrap items-center justify-between gap-3 mt-6 border-y border-line/40 py-3 font-body text-sm">
      {previous ? <a href={`/album/${previous.data.slug}`} rel="prev" class="text-gold-ink hover:opacity-80">&larr; Previous: {previous.data.title}</a> : <span></span>}
      {next && <a href={`/album/${next.data.slug}`} rel="next" class="text-gold-ink hover:opacity-80">Next: {next.data.title} &rarr;</a>}
      <a href="/album/" class="text-gold-ink hover:opacity-80">Back to Album</a>
      <a id="album-search-return" href="/archive/" hidden class="text-gold-ink hover:opacity-80">Back to Search</a>
    </nav>

    <div class="mt-6">
      {description && <p class="font-body text-lg text-ink-soft max-w-prose">{description}</p>}
      {audio && (
        <audio controls preload="metadata" src={audio} class="w-full mt-6">
          Your browser does not support audio playback.
        </audio>
      )}
      {streamingLinks.length > 0 && (
        <ul class="flex flex-wrap gap-3 mt-5">
          {streamingLinks.map((link) => (
            <li><a href={link.url} rel="noopener" class="inline-block font-body text-sm uppercase tracking-[0.1em] border border-gold text-gold-ink px-4 py-2 rounded-sm hover:bg-charcoal transition-colors">{link.label}</a></li>
          ))}
        </ul>
      )}
    </div>

    <div class="font-body text-ink-soft mt-10 max-w-prose [&_p]:mt-4">
      <Content />
    </div>

    {
      additionalMusicVideos.length > 0 && (
        <section class="mt-16">
          <h2 class="font-display text-title text-ink">Music Videos</h2>
          <div class="grid gap-6 mt-5">
            {additionalMusicVideos.map((v) =>
              v.data.youtubeId ? (
                <div>
                  <YouTubeEmbed id={v.data.youtubeId} title={v.data.title} poster={v.data.thumbnail} orientation={v.data.orientation} />
                  <p class="font-body text-sm text-ink-soft mt-2">
                    <a href={`/watch/${v.data.slug}`} class="text-gold-ink hover:opacity-80">
                      {v.data.title} &rarr;
                    </a>
                  </p>
                </div>
              ) : (
                <WatchCard
                  href={`/watch/${v.data.slug}`}
                  title={v.data.title}
                  typeLabel={videoTypeLabel[v.data.type]}
                  thumbnail={v.data.thumbnail}
                  youtubeId={v.data.youtubeId}
                  orientation={v.data.orientation}
                  duration={v.data.duration}
                />
              ),
            )}
          </div>
        </section>
      )
    }

    {
      additionalPerformances.length > 0 && (
        <section class="mt-16">
          <h2 class="font-display text-title text-ink">More Performances</h2>
          <div class="grid sm:grid-cols-2 gap-5 mt-5">
            {additionalPerformances.map((v) => (
              <WatchCard
                href={`/watch/${v.data.slug}`}
                title={v.data.title}
                typeLabel={videoTypeLabel[v.data.type]}
                thumbnail={v.data.thumbnail}
                  youtubeId={v.data.youtubeId}
                  orientation={v.data.orientation}
                duration={v.data.duration}
              />
            ))}
          </div>
        </section>
      )
    }

    {
      clips.length > 0 && (
        <section class="mt-16">
          <h2 class="font-display text-title text-ink">Clips</h2>
          <div class="grid sm:grid-cols-3 gap-5 mt-5">
            {clips.map((v) => (
              <WatchCard
                href={`/watch/${v.data.slug}`}
                title={v.data.title}
                typeLabel={videoTypeLabel[v.data.type]}
                thumbnail={v.data.thumbnail}
                  youtubeId={v.data.youtubeId}
                  orientation={v.data.orientation}
                duration={v.data.duration}
              />
            ))}
          </div>
        </section>
      )
    }

    {
      gallery.length > 0 && (
        <section class="mt-16">
          <h2 class="font-display text-title text-ink">Gallery</h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-5">
            {gallery.map((i) => (
              <figure class="border border-line rounded-lg overflow-hidden">
                <a href={artHref('images', i.id)} class="block"><MediaThumb src={i.data.image} alt={i.data.alt} fit="natural" sizes="(min-width: 896px) 267px, (min-width: 640px) 30vw, calc((100vw - 64px) / 2)" /></a>
                {i.data.caption && (
                  <figcaption class="font-body text-xs text-ink-soft/70 p-2">{i.data.caption}</figcaption>
                )}
              </figure>
            ))}
          </div>
        </section>
      )
    }

    {
      credits.length > 0 && (
        <section class="mt-16">
          <h2 class="font-display text-xl text-ink">Credits</h2>
          <ul class="font-body text-sm text-ink-soft mt-3 space-y-1">
            {credits.map((c) => (
              <li>{c}</li>
            ))}
          </ul>
        </section>
      )
    }

  </article>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const returnLink = document.getElementById('album-search-return') as HTMLAnchorElement | null;
  if (returnLink && params.get('from') === 'search') {
    const destination = new URL('/archive/', window.location.origin);
    const query = params.get('q');
    const type = params.get('type');
    const page = params.get('page');
    const allowedTypes = new Set(['all', 'music-video', 'album-song', 'deep-cuts', 'sketch', 'short', 'mctrumps', 'image']);
    if (query) destination.searchParams.set('q', query.slice(0, 200));
    if (type && allowedTypes.has(type)) destination.searchParams.set('type', type);
    if (page && /^[1-9]\d{0,2}$/.test(page)) destination.searchParams.set('page', page);
    returnLink.href = destination.pathname + destination.search;
    returnLink.hidden = false;
  }
</script>

<style>
  :global(.song-player .video-frame[data-orientation="9:16"]) { max-width: min(100%, 32vh, 304px) !important; }
  :global(.song-player .video-frame[data-orientation="16:9"]) { max-width: min(100%, 106vh) !important; }
  :global(.song-player .video-frame[data-orientation="1:1"]) { max-width: min(100%, 58vh) !important; }
</style>
