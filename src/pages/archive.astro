---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import MediaThumb from '../components/MediaThumb.astro';
import ArtworkViewer from '../components/ArtworkViewer.astro';
import { buildArchive, isArtwork } from '../lib/archive';
const cards = buildArchive({
  tracks: await getCollection('tracks'), videos: await getCollection('videos'),
  images: await getCollection('images'), evidence: await getCollection('evidence'),
});
const categoryLabels: Record<string, string> = {
  'music-video': 'Music Videos', 'album-song': 'Album Songs', 'deep-cuts': 'Deep Cuts Live',
  sketch: 'Sketches', short: 'Shorts', mctrumps: 'McTrumps', image: 'Images',
};
const filters = [{ key: 'all', label: 'All', count: cards.length }, ...Object.entries(categoryLabels).map(([key, label]) => ({ key, label, count: cards.filter((card) => card.category === key).length })).filter((filter) => filter.count)];
const searchIndex = cards.map(({ id, category, title, description, caption, track }) => ({ id, category, title, description, caption, track }));
---
<BaseLayout title="Search — Booze on Hormuz™" description="Find songs, videos, and artwork in Don Biggly's growing paper trail.">
  <PageHeader eyebrow="Find something" title="Search" />
  <section class="px-6 pb-20 md:pb-28 max-w-4xl mx-auto">
    {cards.length === 0 ? <p class="font-display text-title text-ink">No items are available yet.</p> : <Fragment>
      <div id="archive-controls" aria-hidden="true" inert hidden>
        <form id="archive-search" role="search" class="flex flex-wrap items-end gap-3">
          <div class="flex-1 min-w-[min(100%,10rem)]"><label for="archive-query" class="block text-sm text-ink-soft mb-2">Search songs, videos, and images</label><input id="archive-query" name="q" type="search" maxlength="200" placeholder="Search titles and captions" autocomplete="off" class="w-full min-h-11 rounded-sm border border-line bg-charcoal text-ink px-3 py-2" /></div>
          <button type="button" id="archive-reset" class="min-h-11 border border-line rounded-sm text-gold-ink px-4 py-2">Reset</button>
        </form>
        <div class="archive-filter-list flex flex-wrap gap-2 mt-4" role="group" aria-label="Filter search results" id="archive-filters">
          {filters.map((filter) => <button type="button" data-filter={filter.key} aria-pressed="false" class="font-body text-sm px-4 py-2 min-h-11 rounded-sm border border-line/60 text-ink-soft aria-pressed:border-gold aria-pressed:text-gold-ink hover:text-gold-ink">{filter.label} <span>({filter.count})</span></button>)}
        </div>
      </div>
      <div id="archive-recovery" class="font-body text-ink-soft mt-4"><p>Search is unavailable. Browse these collections:</p><div class="flex flex-wrap gap-x-5 gap-y-2 mt-2"><a class="text-gold-ink min-h-11 inline-flex items-center" href="/album/">Album Songs</a><a class="text-gold-ink min-h-11 inline-flex items-center" href="/watch/">Videos</a><a class="text-gold-ink min-h-11 inline-flex items-center" href="/deep-cuts/">Deep Cuts Live</a><a class="text-gold-ink min-h-11 inline-flex items-center" href="/gallery/">Gallery</a></div></div>
      <p id="archive-count" class="font-body text-sm text-ink-soft mt-5" role="status">Search {cards.length} items or choose a type.</p>
      <div class="grid grid-cols-1 min-[360px]:grid-cols-2 sm:grid-cols-3 gap-3 mt-4 items-start" id="archive-grid"></div>
      <p hidden class="font-display text-xl text-ink mt-8" id="archive-empty">No matches. Try another search or type.</p>
      <nav id="archive-pagination" aria-label="Search results pages" class="flex items-center justify-between gap-4 mt-7" hidden>
        <button type="button" data-page="previous" class="min-h-11 border border-line rounded-sm px-4 text-gold-ink disabled:opacity-50">Previous</button>
        <span id="archive-page-status" class="font-body text-sm text-ink-soft" role="status"></span>
        <button type="button" data-page="next" class="min-h-11 border border-line rounded-sm px-4 text-gold-ink disabled:opacity-50">Next</button>
      </nav>
      <div id="archive-templates" hidden>
        {cards.map((card) => <template data-card-id={card.id}>
          <div data-archive-item data-id={card.id} data-type={card.category}>
            <a href={card.href} data-detail-href={card.href} data-art-id={card.kind === 'art' ? card.id : undefined} class="group flex items-center gap-3 min-h-20 card-marble border border-line rounded-lg overflow-hidden hover:border-gold transition-colors">
              <div class="w-20 h-20 shrink-0 overflow-hidden"><MediaThumb src={card.thumbnail} alt={card.alt} aspect="aspect-square" fit="cover" sizes="80px" /></div>
              <div class="min-w-0 py-2 pr-3"><p class="font-body text-xs uppercase text-gold-ink">{card.label}</p><h2 class="font-display text-base text-ink mt-1 group-hover:text-gold-ink">{card.title}</h2></div>
            </a>
          </div>
        </template>)}
      </div>
      <script id="archive-search-data" type="application/json" set:html={JSON.stringify(searchIndex).replaceAll('<', '\\u003c')} />
      <ArtworkViewer items={cards.filter(isArtwork)} />
    </Fragment>}
  </section>
</BaseLayout>
<script>
  import { initializeArchiveSearch } from '../lib/archive-search';
  initializeArchiveSearch();
</script>
<style is:global>
  #archive-controls[hidden], #archive-pagination[hidden], #archive-recovery[hidden] { display: none !important; }
</style>
