---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import MediaThumb from '../components/MediaThumb.astro';
import {
  playableTracks,
  liveVideos,
  liveImages,
  videoTypeLabel,
  imageTypeLabel,
} from '../lib/media';

// Everything, one filterable grid. Tracks, videos, and images come from the
// media collections; the live Evidence Lounge exhibits are folded in so the
// archive is never empty. Cards link to each asset's home page.
const tracks = playableTracks(await getCollection('tracks'));
const videos = liveVideos(await getCollection('videos'));
const images = liveImages(await getCollection('images'));
const evidenceArt = (await getCollection('evidence')).filter(
  (e) => !e.data.draft && (e.data.kind === 'titlecard' || e.data.kind === 'gallery'),
);
const trackTitleById = new Map(tracks.map((t) => [t.id, t.data.title]));
const trackSlugById = new Map(tracks.map((t) => [t.id, t.data.slug]));

// Filter keys: track | music-video | performance | short | sketch | image | poster | bts
type Card = {
  href: string;
  filter: string;
  label: string;
  title: string;
  image?: string;
  alt: string;
  trackTitle?: string;
  aspect: string;
};

const cards: Card[] = [
  ...tracks.map((t) => ({
    href: `/album/${t.data.slug}`,
    filter: 'track',
    label: 'Track',
    title: t.data.title,
    image: t.data.cover,
    alt: `Cover art for ${t.data.title}`,
    aspect: 'aspect-square',
  })),
  ...videos.map((v) => ({
    href: `/watch/${v.data.slug}`,
    filter: v.data.type,
    label: videoTypeLabel[v.data.type],
    title: v.data.title,
    image: v.data.thumbnail ?? (v.data.youtubeId ? `https://i.ytimg.com/vi/${v.data.youtubeId}/hqdefault.jpg` : undefined),
    alt: v.data.title,
    trackTitle: v.data.track ? trackTitleById.get(v.data.track.id) : undefined,
    aspect: 'aspect-video',
  })),
  ...images.map((i) => ({
    href:
      i.data.track && trackSlugById.has(i.data.track.id)
        ? `/album/${trackSlugById.get(i.data.track.id)}`
        : '/archive',
    filter: i.data.type === 'poster' || i.data.type === 'fake-ad' ? 'poster' : i.data.type === 'bts' ? 'bts' : 'image',
    label: imageTypeLabel[i.data.type],
    title: i.data.title,
    image: i.data.thumb ?? i.data.image,
    alt: i.data.alt,
    trackTitle: i.data.track ? trackTitleById.get(i.data.track.id) : undefined,
    aspect: 'aspect-square',
  })),
  ...evidenceArt.map((e: any) => ({
    href: '/evidence-lounge',
    filter: 'image',
    label: e.data.kind === 'titlecard' ? 'Title Card' : 'Exhibit',
    title: e.data.title,
    image: e.data.image,
    alt: e.data.title,
    aspect: 'aspect-square',
  })),
];

const filters = [
  { key: 'all', label: 'All' },
  { key: 'track', label: 'Tracks' },
  { key: 'music-video', label: 'Music Videos' },
  { key: 'performance', label: 'Performances' },
  { key: 'sketch', label: 'Sketches' },
  { key: 'short', label: 'Shorts' },
  { key: 'image', label: 'Images' },
  { key: 'poster', label: 'Posters' },
  { key: 'bts', label: 'Behind the Scenes' },
];
---

<BaseLayout
  title="Archive — Booze on Hormuz™"
  description="The complete Booze on Hormuz archive — tracks, films, performances, stills, posters, and assorted very legal receipts, filterable."
>
  <PageHeader eyebrow="Everything, admissible" title="Archive" />

  <section class="px-6 pb-28 max-w-4xl mx-auto">
    {
      cards.length === 0 ? (
        <p class="font-display text-title text-ink max-w-2xl">
          The archive is being catalogued by people in white gloves. Exhibits arrive one at a
          time, each with a number and an alibi.
        </p>
      ) : (
        <Fragment>
          <div class="flex flex-wrap gap-2" role="group" aria-label="Filter the archive" id="archive-filters">
            {filters.map((f, idx) => (
              <button
                type="button"
                data-filter={f.key}
                aria-pressed={idx === 0 ? 'true' : 'false'}
                class:list={[
                  'font-body text-sm uppercase tracking-[0.1em] px-4 py-2 rounded-sm border transition-colors',
                  'aria-pressed:border-gold aria-pressed:text-gold-ink border-line/60 text-ink-soft hover:text-gold-ink',
                ]}
              >
                {f.label}
              </button>
            ))}
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-5 mt-8" id="archive-grid">
            {cards.map((c) => (
              <div data-type={c.filter}>
                <a href={c.href} class="group block card-marble border border-line rounded-xl overflow-hidden shadow-lg hover:border-gold transition-colors">
                  <MediaThumb src={c.image} alt={c.alt} aspect={c.aspect} />
                  <div class="p-3">
                    <p class="font-body text-eyebrow uppercase text-gold-ink">{c.label}</p>
                    <h3 class="font-display text-lg text-ink mt-1 group-hover:text-gold-ink transition-colors">
                      {c.title}
                    </h3>
                    {c.trackTitle && (
                      <p class="font-body text-xs text-ink-soft/80 mt-1">From “{c.trackTitle}”</p>
                    )}
                  </div>
                </a>
              </div>
            ))}
          </div>

          <p class="hidden font-display text-xl text-ink mt-10" id="archive-empty">
            Nothing filed under this category yet. The white-glove people are aware.
          </p>

          <script>
            const group = document.getElementById('archive-filters');
            const grid = document.getElementById('archive-grid');
            const empty = document.getElementById('archive-empty');
            group?.addEventListener('click', (ev) => {
              const btn = (ev.target as HTMLElement).closest('button[data-filter]');
              if (!btn || !grid || !empty) return;
              const filter = btn.getAttribute('data-filter');
              group.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
              let visible = 0;
              grid.querySelectorAll<HTMLElement>('[data-type]').forEach((card) => {
                const show = filter === 'all' || card.dataset.type === filter;
                card.style.display = show ? '' : 'none';
                if (show) visible++;
              });
              empty.classList.toggle('hidden', visible > 0);
            });
          </script>
        </Fragment>
      )
    }
  </section>
</BaseLayout>
