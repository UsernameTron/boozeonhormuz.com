---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import AudioTrack from '../components/AudioTrack.astro';
import ListeningController from '../components/ListeningController.astro';
import { listeningQueue, orderedListeningTracks } from '../lib/listening';

const tracks = await getCollection('tracks');
const ordered = orderedListeningTracks(tracks).filter((track) => Boolean(track.data.audio));
const queue = listeningQueue(tracks);
---

<BaseLayout
  title="Listen | Booze on Hormuz™"
  description="Standalone audio, when available, from Booze on Hormuz. The live album's songs are filmed performances with lyrics on screen."
>
  <PageHeader eyebrow="Standalone audio" title="Listen" />

  <section class="px-6 pb-28 max-w-4xl mx-auto">
    {
      ordered.length === 0 ? (
        <Fragment>
          <p class="font-display text-title text-ink max-w-2xl">
            This album is a live show by Don Biggly &amp; The Indictments. Its songs are videos
            with lyrics on screen. There are no standalone audio tracks here yet.
          </p>
          <p class="font-body text-ink-soft mt-6">
            <a href="/album" class="text-gold-ink hover:opacity-80">Explore the album and its filmed setlist</a>.
          </p>
        </Fragment>
      ) : (
        <ListeningController queue={queue}>
        <div class="grid gap-5">
          {ordered.map((t) => (
            <AudioTrack
              id={t.id}
              title={t.data.title}
              slug={t.data.slug}
              cover={t.data.cover}
              audio={t.data.audio}
              duration={t.data.duration}
            />
          ))}
        </div>
        </ListeningController>
      )
    }
  </section>
</BaseLayout>
