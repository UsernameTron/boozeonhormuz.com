---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

// The game ships as a standalone HTML app in public/apps/ and is embedded via
// iframe — the same deliberate isolation boundary the creative tools use: the
// app carries its own reset + :root tokens that would collide with Tailwind
// @theme if inlined, while Nav + Footer + the global disclaimer still wrap it.
---

<BaseLayout
  title="Play — Booze on Hormuz™"
  description="Don Biggly's Tremendous Exit Strategy — the ship is sinking, the exit is free, and that's the problem. A playable disaster in ten levels."
>
  <PageHeader eyebrow="A playable disaster" title="Don Biggly's Tremendous Exit Strategy" />

  <div class="px-6 pb-6 max-w-5xl mx-auto font-body">
    <p class="text-ink-soft max-w-2xl">
      The ship is sinking. The exit is three feet away. Unfortunately, the exit is free. Your
      mission is not to rescue Don Biggly — it is to manipulate his ego until he accidentally
      rescues himself. Ten levels, two meters, three Gold Stars. It runs entirely in your
      browser — nothing is saved, tracked, or sent anywhere.
    </p>
  </div>

  <div class="px-6 pb-20 max-w-5xl mx-auto">
    <iframe
      src="/apps/exit-strategy.html"
      title="Don Biggly's Tremendous Exit Strategy"
      class="w-full h-[88vh] min-h-[700px] rounded-lg border border-line bg-charcoal"
      loading="eager"
    ></iframe>
    <p class="mt-3 text-xs text-ink-soft/80 font-body">
      The game runs entirely in this frame — no backend, no accounts, no saves. Fictional
      satire with zero maritime safety value.
      <a href="/legal" class="text-gold-ink hover:opacity-80">Very Legal Disclaimer</a>.
    </p>
  </div>
</BaseLayout>
