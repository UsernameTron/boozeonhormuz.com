---
import BaseLayout from '../layouts/BaseLayout.astro';

// Keep the standalone game's styles and state isolated inside its original iframe.
---

<BaseLayout
  title="Play — Booze on Hormuz™"
  description="Don Biggly's Tremendous Exit Strategy — the ship is sinking, the exit is free, and that's the problem. A playable disaster in ten levels."
>
  <header class="play-intro font-body">
    <p class="text-eyebrow uppercase text-gold-ink">A playable disaster</p>
    <h1 class="font-display text-ink">Don Biggly's Tremendous Exit Strategy</h1>
    <p class="text-ink-soft">Ten levels. Two meters. One very expensive refusal to leave.</p>
  </header>

  <div class="play-wrap">
    <dialog open id="playStage" class="play-stage font-body" aria-labelledby="playStageLabel">
      <div class="play-toolbar">
        <p id="playStageLabel" class="text-ink">The departure lounge</p>
        <button type="button" id="expandPlay" class="play-toggle" aria-expanded="false" aria-controls="gameFrame" hidden>Expand play</button>
      </div>
      <iframe
        id="gameFrame"
        src="/apps/exit-strategy.html"
        title="Don Biggly's Tremendous Exit Strategy"
        loading="eager"
      ></iframe>
      <p class="play-disclaimer text-ink-soft">
        Runs in your browser. No accounts or tracking. A completed report stays on this device only
        when you choose Save. Fictional satire with zero maritime safety value.
        <a href="/legal" class="text-gold-ink">Very Legal Disclaimer</a>.
      </p>
    </dialog>
  </div>
</BaseLayout>

<style>
  .play-intro { max-width: 72rem; margin: 0 auto; padding: 1.5rem 1rem 1rem; }
  .play-intro h1 { font-size: clamp(1.6rem, 3.8vw, 2.7rem); line-height: 1.1; margin: .5rem 0; }
  .play-intro > p:last-child { margin-top: .75rem; font-size: .95rem; }
  .play-wrap { max-width: 72rem; margin: 0 auto; padding: 0 1rem 3rem; }
  .play-stage { position: static; width: 100%; max-width: none; max-height: none; padding: 0; margin: 0; border: 1px solid var(--color-line); border-radius: .75rem; background: var(--color-charcoal); color: var(--color-ink); overflow: hidden; }
  .play-stage[open] { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; }
  .play-toolbar { display: flex; align-items: center; justify-content: space-between; gap: .75rem; padding: .6rem .75rem; }
  .play-toolbar p { font-size: .85rem; }
  .play-toggle { flex-shrink: 0; min-height: 44px; padding: .5rem .75rem; border: 1px solid var(--color-gold-ink); border-radius: .4rem; color: var(--color-gold-ink); font-size: .85rem; cursor: pointer; }
  .play-toggle:hover { background: color-mix(in srgb, var(--color-gold-ink) 12%, transparent); }
  .play-toggle:focus-visible, .play-disclaimer a:focus-visible { outline: 3px solid var(--color-gold-ink); outline-offset: 3px; }
  iframe { display: block; width: 100%; height: 82vh; height: 82dvh; min-height: 580px; border: 0; background: #040810; }
  .play-disclaimer { margin: 0; padding: .75rem; border-top: 1px solid var(--color-line); font-size: .75rem; line-height: 1.5; }
  .play-disclaimer a { text-decoration: underline; text-underline-offset: 3px; }
  .play-stage.expanded { position: fixed; inset: 0; margin: 0; width: 100%; height: 100vh; height: 100dvh; max-width: 100vw; max-height: 100dvh; border-radius: 0; }
  .play-stage.expanded iframe { height: 100%; min-height: 0; }
  .play-stage::backdrop { background: #040810; }
  @media (min-width: 768px) {
    .play-intro { padding: 2rem 1.5rem 1.25rem; }
    .play-wrap { padding: 0 1.5rem 4rem; }
  }
</style>

<script>
  const stage = document.querySelector<HTMLDialogElement>('#playStage');
  const toggle = document.querySelector<HTMLButtonElement>('#expandPlay');
  const frame = document.querySelector<HTMLIFrameElement>('#gameFrame');
  if (stage && toggle && frame && typeof stage.showModal === 'function') {
    let expanded = false;
    let scrollY = 0;
    let previousOverflow = '';
    toggle.hidden = false;
    const setExpanded = (next: boolean) => {
      if (next === expanded) return;
      expanded = next;
      stage.close();
      stage.classList.toggle('expanded', expanded);
      toggle.textContent = expanded ? 'Exit expanded play' : 'Expand play';
      toggle.setAttribute('aria-expanded', String(expanded));
      if (expanded) {
        scrollY = window.scrollY;
        previousOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        stage.showModal();
      } else {
        document.body.style.overflow = previousOverflow;
        stage.show();
        window.scrollTo({ top: scrollY, behavior: 'instant' });
      }
      toggle.focus({ preventScroll: true });
    };
    toggle.addEventListener('click', () => setExpanded(!expanded));
    stage.addEventListener('cancel', (event) => {
      event.preventDefault();
      setExpanded(false);
    });
    // Keyboard events inside the frame do not bubble into the wrapper.
    frame.addEventListener('load', () => {
      frame.contentDocument?.addEventListener('keydown', (event) => {
        if (expanded && event.key === 'Escape') {
          event.preventDefault();
          setExpanded(false);
        }
      });
    });
  }
</script>
