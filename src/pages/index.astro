---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Booze on Hormuz™ — Warships on the horizon. Champagne on ice."
  description="The world's premier crisis-adjacent luxury experience. Warships on the horizon. Champagne on ice."
>
  <!--
    Branded landing — Checkpoint B reskin. Content-free (no episodes/products/quotes).
    Typographic hero works as-is; the owner-produced Don Biggly hero image drops into
    the slot below (see HERO IMAGE SLOT) without layout rework.
  -->
  <section class="px-6 pt-20 pb-16 md:pt-28 max-w-4xl mx-auto">
    <p class="font-body text-eyebrow uppercase text-gold-ink">Est. in very legal waters</p>

    <h1 class="font-display text-display text-ink metal-gold mt-5 break-words">
      Booze on Hormuz<sup class="text-[0.4em] align-super">™</sup>
    </h1>

    <p class="font-display text-title text-ink-soft mt-6 max-w-2xl">
      Warships on the horizon. Champagne on ice.
    </p>

    <div class="mt-10 flex items-center gap-5">
      <a
        href="/evidence-lounge"
        class="inline-block bg-stamp text-ink border border-gold font-body text-sm uppercase tracking-[0.2em] px-8 py-4 hover:bg-gold hover:text-paper transition-colors"
      >
        Enter the Evidence Lounge
      </a>
    </div>

    <img
      src="/hero.webp"
      alt="The Booze on Hormuz mega-cruise — a gold-plated party ship amid warships, jets, and fire: All-Inclusive Consequences"
      class="mt-14 w-full border-2 brass-rule"
      width="1536"
      height="1024"
    />

    <hr class="mt-16 border-0 border-t brass-rule" />
  </section>

  <!-- Homepage intro — links onward to the real Evidence Lounge -->
  <section class="px-6 pb-28 max-w-4xl mx-auto">
    <p class="font-body text-eyebrow uppercase text-gold-ink">The Evidence Lounge</p>
    <p class="font-display text-title text-ink mt-4 max-w-2xl">
      Now being appointed. Velvet rope pending. The shrimp are already chilled.
    </p>
    <p class="font-body text-ink-soft mt-4 max-w-xl">
      Clips, exhibits, and assorted very legal receipts will be on display shortly.
      Relax. It's probably nothing.
    </p>
    <a href="/evidence-lounge" class="inline-block font-body text-sm uppercase tracking-[0.1em] text-gold-ink mt-5 hover:opacity-80">
      View the exhibits &rarr;
    </a>
  </section>
</BaseLayout>
