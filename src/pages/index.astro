---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaThumb from '../components/MediaThumb.astro';
import ArtworkViewer from '../components/ArtworkViewer.astro';
import { buildArchive, isArtwork, artHref, qualifiedId } from '../lib/archive';
import { responsiveImage } from '../lib/responsive-media';
import { playableTracks, liveVideos, liveImages } from '../lib/media';

const album = (await getCollection('albums')).find((entry) => !entry.data.draft);
const tracks = playableTracks(await getCollection('tracks'));
const videos = liveVideos(await getCollection('videos'));
const images = liveImages(await getCollection('images'));
const leadFilm = videos.find((video) => video.data.slug === 'hush-money-is-philanthropy');
const evidenceArt = (await getCollection('evidence')).filter(
  (entry) => !entry.data.draft && (entry.data.kind === 'titlecard' || entry.data.kind === 'gallery'),
);
const artwork = buildArchive({ tracks, videos: [], images, evidence: evidenceArt }).filter(isArtwork);
const galleryPreview = images.length > 0
  ? [...images.filter((image) => image.data.featured), ...images.filter((image) => !image.data.featured)]
      .slice(0, 6)
      .map((image) => ({
        href: artHref('images', image.id),
        id: qualifiedId('images', image.id),
        image: image.data.thumb ?? image.data.image,
        alt: image.data.alt,
      }))
  : evidenceArt.slice(0, 6).map((entry) => ({
      href: artHref('evidence', entry.id),
      id: qualifiedId('evidence', entry.id),
      image: 'image' in entry.data ? entry.data.image : '',
      alt: entry.data.title,
    }));
---

<BaseLayout
  title="Booze on Hormuz™ — Musical Satire, Performance, Video"
  description="Songs, videos, and a resort Don Biggly insists is open for business. Explore Booze on Hormuz."
>
  <section class="relative overflow-hidden border-b brass-rule">
    <img
      src="/hero.webp"
      {...responsiveImage('/hero.webp')}
      sizes="100vw"
      loading="eager"
      decoding="async"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover opacity-25"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-paper/40 via-paper/75 to-paper"></div>
    <div class="relative px-6 py-9 md:py-12 max-w-5xl mx-auto">
      <h1 class="font-display text-display metal-gold">Booze on Hormuz</h1>
      <p class="font-body text-base md:text-lg text-ink-soft mt-3">Songs. Films. A resort. Counsel calls it a pattern.</p>
      {leadFilm ? (
        <div class="mt-8 grid md:grid-cols-[1fr_auto] gap-6 md:gap-10 items-center">
          <div class="md:order-1">
            <p class="font-body text-eyebrow uppercase text-gold-ink">Featured music video</p>
            <h2 class="font-display text-title text-ink mt-2">{leadFilm.data.title}</h2>
            <p class="font-body text-sm text-gold-ink mt-2 tabular-nums">{leadFilm.data.duration}</p>
            <p class="font-body text-ink-soft mt-4 max-w-prose">{leadFilm.data.description}</p>
            <a
              href={`/watch/${leadFilm.data.slug}`}
              class="inline-flex min-h-11 items-center font-body uppercase tracking-[0.1em] bg-stamp text-ink px-6 py-3 rounded-sm mt-5 hover:opacity-90 transition-opacity"
            >
              &#9655;&nbsp; Watch the music video
            </a>
          </div>
          <a href={`/watch/${leadFilm.data.slug}`} aria-label={`Watch ${leadFilm.data.title}`} class="block w-full max-w-[236px] md:w-[236px] mx-auto rounded-xl overflow-hidden border border-line shadow-lg hover:border-gold transition-colors">
            <MediaThumb src="/covers/hush-money-featured.webp" width={1023} height={1537} fit="natural" alt={leadFilm.data.title} sizes="236px" play priority />
          </a>
        </div>
      ) : (
        <a href="/watch/" class="inline-flex min-h-11 items-center font-body uppercase text-gold-ink mt-6">Explore the videos &rarr;</a>
      )}
    </div>
  </section>

  <section class="px-6 py-9 md:py-12 max-w-5xl mx-auto" aria-label="Explore the collections">
    <div class="grid sm:grid-cols-3 gap-4">
      <a href="/watch/" class="group card-marble border border-line rounded-xl p-5 hover:border-gold transition-colors">
        <h2 class="font-display text-xl text-ink group-hover:text-gold-ink">Watch</h2>
        <p class="font-body text-sm text-ink-soft mt-2">Music videos and performances. Nobody cleared the outtakes.</p>
        <span class="font-body text-sm text-gold-ink inline-block mt-3">Browse videos &rarr;</span>
      </a>
      <a href="/album/" class="group card-marble border border-line rounded-xl p-5 hover:border-gold transition-colors flex gap-4 items-start">
        {album?.data.artwork && <img src={album.data.artwork} alt="" loading="lazy" class="w-14 h-14 object-contain shrink-0 rounded" />}
        <div>
          <h2 class="font-display text-xl text-ink group-hover:text-gold-ink">Album</h2>
          <span class="font-body text-sm text-ink-soft block mt-2">All 27 song videos. I approved the order.</span>
          <span class="font-body text-sm text-gold-ink inline-block mt-3">Open the setlist &rarr;</span>
        </div>
      </a>
      <a href="/gallery/" class="group card-marble border border-line rounded-xl p-5 hover:border-gold transition-colors">
        <h2 class="font-display text-xl text-ink group-hover:text-gold-ink">Gallery</h2>
        <p class="font-body text-sm text-ink-soft mt-2">Stills, posters, and photographs I denied posing for.</p>
        <span class="font-body text-sm text-gold-ink inline-block mt-3">View the gallery &rarr;</span>
      </a>
    </div>
  </section>

  {galleryPreview.length > 0 && (
    <section class="px-6 py-8 max-w-5xl mx-auto border-t border-line/40">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="font-display text-xl text-ink">From the gallery</h2>
        <a href="/gallery/" class="font-body text-sm uppercase tracking-[0.1em] text-gold-ink hover:opacity-80">Open the Gallery &rarr;</a>
      </div>
      <div class="grid grid-cols-3 sm:grid-cols-6 gap-3 mt-5 items-start">
        {galleryPreview.map((item) => (
          <a href={item.href} data-art-id={item.id} aria-label={`View ${item.alt}`} class="block border border-line rounded-lg overflow-hidden hover:border-gold transition-colors">
            <MediaThumb src={item.image} alt={item.alt} fit="natural" sizes="(min-width: 896px) 150px, 30vw" />
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="px-6 py-8 max-w-5xl mx-auto border-t border-line/40">
    <div class="grid sm:grid-cols-2 gap-5 items-center">
      <a href="/products/" class="group flex items-center gap-5 card-marble border border-line rounded-xl p-4 hover:border-gold transition-colors">
        <img src="/products/captain-crunk-collection.png" alt="Captain Crunk cereal box" width="640" height="800" loading="lazy" class="w-24 h-32 object-contain shrink-0" />
        <div>
          <h2 class="font-display text-xl text-ink group-hover:text-gold-ink">Products</h2>
          <p class="font-body text-sm text-ink-soft mt-2">Cereal, cologne, cufflinks. Counsel signed nothing.</p>
          <span class="inline-flex min-h-11 items-center font-body text-sm text-gold-ink">Browse products &rarr;</span>
        </div>
      </a>
      <div>
        <h2 class="font-display text-xl text-ink">Explore the world</h2>
        <p class="font-body text-sm text-ink-soft mt-1">The resort, the game, and several very expensive decisions.</p>
        <a href="/explore/" class="inline-flex min-h-11 items-center font-body text-sm uppercase tracking-[0.1em] text-gold-ink hover:opacity-80 mt-2">Explore &rarr;</a>
      </div>
    </div>
  </section>

  <section class="px-6 py-8 max-w-5xl mx-auto border-t border-line/40">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <div>
        <h2 class="font-display text-xl text-ink">Want something this ridiculous built for your audience?</h2>
        <p class="font-body text-sm text-ink-soft mt-1">Original songs · comedy concepts · video · campaign creative</p>
      </div>
      <a href="/studio/" class="font-body text-sm uppercase tracking-[0.1em] text-gold-ink hover:opacity-80">Work With The Studio &rarr;</a>
    </div>
  </section>
  <ArtworkViewer items={artwork} />
</BaseLayout>
