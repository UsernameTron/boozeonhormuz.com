---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import EvidenceCard from '../components/EvidenceCard.astro';
import ArtworkViewer from '../components/ArtworkViewer.astro';
import { buildArchive, isArtwork, artHref, qualifiedId } from '../lib/archive';

// The spine of the site. Polymorphic archive grouped by `kind`.
const all = (await getCollection('evidence')).filter((e) => !e.data.draft);
const artwork = buildArchive({ tracks: await getCollection('tracks'), videos: [], images: [], evidence: all }).filter(isArtwork);

const KIND_ORDER = ['clip', 'commercial', 'song', 'titlecard', 'gallery', 'lowerthird', 'prompt'] as const;
const KIND_LABEL: Record<string, string> = {
  clip: 'Clips',
  commercial: 'Commercials',
  song: 'Songs',
  titlecard: 'Title Cards',
  gallery: 'Gallery',
  lowerthird: 'Lower Thirds',
  prompt: 'Prompts',
};

// group entries by kind, preserving KIND_ORDER and dropping empty kinds
const grouped = KIND_ORDER.map((kind) => ({
  kind,
  label: KIND_LABEL[kind],
  items: all.filter((e) => e.data.kind === kind),
})).filter((g) => g.items.length > 0);
---

<BaseLayout
  title="The Evidence Lounge — Booze on Hormuz™"
  description="Clips, commercials, songs, and title cards from Don Biggly. The receipts needed their own room."
>
  <PageHeader eyebrow="Curated collection" title="The Evidence Lounge" />
  <div class="px-6 max-w-4xl mx-auto"><p class="font-body text-ink-soft">Clips, songs, and artwork. The receipts needed their own room. <a href="/gallery/?type=evidence" class="text-gold-ink">View all {artwork.length} artworks in Gallery →</a></p></div>

  {
    grouped.length === 0 ? (
      <section class="px-6 pb-28 max-w-4xl mx-auto">
        <p class="font-display text-title text-ink max-w-2xl">
          The room is ready. I bought the rope before the exhibits.
        </p>
        <p class="font-body text-ink-soft mt-4 max-w-xl">
          Clips, exhibits, and receipts will appear here when they are ready.
        </p>
      </section>
    ) : (
      <div class="px-6 pb-28 max-w-4xl mx-auto">
        <nav aria-label="Exhibits" class="sticky top-0 z-10 bg-charcoal py-3 border-b border-line flex flex-nowrap overflow-x-auto gap-x-5 -mx-6 px-6 font-body text-sm">
          {grouped.map((g) => (
            <a href={`#${g.kind}`} class="text-ink-soft hover:text-gold-ink uppercase tracking-[0.08em] whitespace-nowrap shrink-0">
              {g.label}
            </a>
          ))}
        </nav>

        {grouped.map((g) => (
          <section id={g.kind} class="mt-12 scroll-mt-20">
            <h2 class="font-display text-title text-ink">{g.label}</h2>
            <div class="grid gap-4 sm:gap-5 sm:grid-cols-2 mt-5">
              {g.items.map((e) => (
                <EvidenceCard data={e.data} artworkHref={e.data.kind === 'titlecard' || e.data.kind === 'gallery' ? `${artHref('evidence', e.id)}?from=evidence` : undefined} artworkId={qualifiedId('evidence', e.id)} />
              ))}
            </div>
          </section>
        ))}
      </div>
    )
  }
  <ArtworkViewer items={artwork} />
</BaseLayout>
