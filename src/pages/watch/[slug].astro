---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import SponsorRead from '../../components/SponsorRead.astro';
import WatchCard from '../../components/WatchCard.astro';
import MediaThumb from '../../components/MediaThumb.astro';
import { artHref } from '../../lib/archive';
import { mediaImageSource, responsiveImage } from '../../lib/responsive-media';
import LocalVideo from '../../components/LocalVideo.astro';
import {
  liveVideos,
  liveImages,
  playableTracks,
  videoTypeLabel,
  toISODuration,
  videoThumbnail,
  validateWatchSlugs,
} from '../../lib/media';

// One watch route serves both worlds: media-library videos (dedicated watch
// pages with VideoObject structured data) and legacy episodes of
// Who the Hell Is Don Biggly?
export async function getStaticPaths() {
  const episodes = (await getCollection('episodes')).filter((e) => !e.data.draft)
    .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
  const sponsors = (await getCollection('sponsors')).filter((s) => !s.data.draft);
  const videos = liveVideos(await getCollection('videos'));
  validateWatchSlugs([...videos, ...episodes]);
  const groupOf = (video: (typeof videos)[number]) => video.data.collection?.href === '/deep-cuts/' ? 'deep-cuts'
    : video.data.track && video.data.type === 'performance' ? 'album'
    : video.data.type === 'sponsor-read' ? 'mctrumps' : video.data.type;
  const navigation = [
    ...videos.map((video) => ({ slug: video.data.slug, title: video.data.title, group: groupOf(video), order: video.data.collectionOrder ?? Infinity })),
    ...episodes.map((episode) => ({ slug: episode.data.slug, title: episode.data.title, group: 'sketch', order: Infinity })),
  ];
  const navigationFor = (group: string) => navigation.filter((item) => item.group === group)
    .sort((a, b) => group === 'deep-cuts' || group === 'album' ? a.order - b.order : 0)
    .map(({ slug, title }) => ({ slug, title }));
  const images = liveImages(await getCollection('images'));
  const tracks = playableTracks(await getCollection('tracks'));

  const episodePaths = episodes.map((entry) => ({
    params: { slug: entry.data.slug },
    props: {
      kind: 'episode' as const,
      entry,
      relatedSponsors: sponsors.filter((s) => s.data.episode?.id === entry.id),
      video: null,
      track: null,
      stills: [],
      related: [],
      navigation: navigationFor('sketch'),
      collectionKey: 'sketch',
    },
  }));

  const videoPaths = videos.map((video) => {
    const track = video.data.track ? (tracks.find((t) => t.id === video.data.track!.id) ?? null) : null;
    return {
      params: { slug: video.data.slug },
      props: {
        kind: 'video' as const,
        entry: null,
        relatedSponsors: [],
        video,
        track,
        stills: track ? images.filter((i) => i.data.track?.id === track.id).slice(0, 6) : [],
        related: videos
          .filter(
            (v) =>
              v.id !== video.id &&
              (video.data.collection
                ? v.data.collection?.label === video.data.collection.label
                : v.data.type === video.data.type || (track && v.data.track?.id === track.id)),
          )
          .slice(0, 3),
        navigation: navigationFor(groupOf(video)),
        collectionKey: groupOf(video),
      },
    };
  });

  return [...episodePaths, ...videoPaths];
}

const { kind, entry, relatedSponsors, video, track, stills, related, navigation, collectionKey } = Astro.props;

// Shared display fields resolved per branch.
const title = kind === 'video' ? video!.data.title : entry!.data.title;
const description = kind === 'video' ? video!.data.description : entry!.data.summary;
const publishDate = kind === 'video' ? video!.data.publishDate : entry!.data.publishDate;
const youtubeId = kind === 'video' ? video!.data.youtubeId : entry!.data.youtubeId;
const date = publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const frameRatio = kind === 'video' && video!.data.videoWidth && video!.data.videoHeight
  ? video!.data.videoWidth / video!.data.videoHeight
  : kind === 'video' && video!.data.orientation === '9:16' ? 9 / 16
  : kind === 'video' && video!.data.orientation === '1:1' ? 1 : 16 / 9;
const frameWidthLimit = `${Math.round(72 * frameRatio * 100) / 100}dvh`;

// VideoObject structured data (video-SEO): unique name/description/thumbnail
// per watch page, ISO-8601 duration, absolute URLs.
const thumbnail = videoThumbnail({ thumbnail: kind === 'video' ? mediaImageSource(video!.data.thumbnail) : undefined, youtubeId });
const socialDimensions = responsiveImage(thumbnail);
const videoLd =
  youtubeId || (kind === 'video' && video!.data.src)
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'VideoObject',
        name: title,
        description,
        thumbnailUrl: thumbnail?.startsWith('/') ? new URL(thumbnail, Astro.site).href : thumbnail,
        uploadDate: publishDate.toISOString(),
        ...(kind === 'video' && toISODuration(video!.data.duration)
          ? { duration: toISODuration(video!.data.duration) }
          : {}),
        ...(youtubeId
          ? { embedUrl: `https://www.youtube.com/embed/${youtubeId}` }
          : { contentUrl: new URL(video!.data.src!, Astro.site).href }),
      })
    : null;
---

<BaseLayout title={`${title} — Booze on Hormuz™`} description={description} ogImage={thumbnail} ogImageWidth={socialDimensions.width} ogImageHeight={socialDimensions.height}>
  {videoLd && <script is:inline type="application/ld+json" set:html={videoLd} />}

  <article class="px-6 pt-8 md:pt-10 pb-20 md:pb-28 max-w-4xl mx-auto">
    <p class="font-body text-eyebrow uppercase text-gold-ink">
      {kind === 'video' ? videoTypeLabel[video!.data.type] : 'Episode'}
      <span class="text-ink-soft/70 normal-case tracking-normal"> · {date}</span>
      {kind === 'video' && video!.data.duration && (
        <span class="text-ink-soft/70 normal-case tracking-normal"> · {video!.data.duration}</span>
      )}
    </p>
    <h1 class="watch-detail-title font-display text-ink mt-3">{title}</h1>

    {youtubeId && <div class="mt-6 watch-detail-player" style={`--watch-frame-width: ${frameWidthLimit}`}><YouTubeEmbed id={youtubeId} title={title} poster={thumbnail} orientation={kind === 'video' ? video!.data.orientation : '16:9'} /></div>}
    {youtubeId && kind === 'video' && video!.data.src && (
      <p class="font-body text-sm text-ink-soft mt-3">
        <a href={video!.data.src} class="text-gold-ink hover:underline">Play the original file</a>
      </p>
    )}
    {
      kind === 'video' && !youtubeId && video!.data.src && (
        <div class="mt-6 watch-detail-player" style={`--watch-frame-width: ${frameWidthLimit}`}><LocalVideo src={video!.data.src} title={title} poster={video!.data.poster ?? video!.data.thumbnail} orientation={video!.data.orientation} videoWidth={video!.data.videoWidth} videoHeight={video!.data.videoHeight} captions={video!.data.captions} /></div>
      )
    }

    <p class="font-body text-lg text-ink-soft mt-8 max-w-prose">{description}</p>

    {kind === 'video' && video!.data.type === 'sponsor-read' && (
      <p class="font-body text-sm text-ink-soft mt-4">Fictional political satire — not a real statement, quote, recording, or event report.</p>
    )}

    {kind === 'video' && video!.data.collection && (
      <p class="font-body text-sm text-ink-soft mt-4">
        Part of <a href={video!.data.collection.href} class="text-gold-ink hover:opacity-80">{video!.data.collection.label}</a>.
      </p>
    )}

    {
      kind === 'video' && track && (
        <p class="font-body text-sm text-ink-soft mt-4">
          From the track{' '}
          <a href={`/album/${track.data.slug}`} class="text-gold-ink hover:opacity-80">
            {track.data.title}
          </a>
        </p>
      )
    }

    {
      kind === 'video' && video!.data.transcript && (
        <details class="mt-8 max-w-prose">
          <summary class="font-body text-sm uppercase tracking-[0.1em] text-gold-ink cursor-pointer">
            Transcript
          </summary>
          <p class="font-body text-sm text-ink-soft whitespace-pre-line mt-3">{video!.data.transcript}</p>
        </details>
      )
    }

    {
      stills.length > 0 && (
        <section class="mt-16">
          <h2 class="font-display text-title text-ink">Stills</h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-5">
            {stills.map((i) => (
              <a href={artHref('images', i.id)} class="block"><MediaThumb src={i.data.thumb ?? i.data.image} alt={i.data.alt} fit="natural" sizes="(min-width: 896px) 267px, (min-width: 640px) 30vw, calc((100vw - 64px) / 2)" /></a>
            ))}
          </div>
        </section>
      )
    }

    {
      relatedSponsors.length > 0 && (
        <section class="mt-16">
          <hr class="border-0 border-t border-line" />
          <h2 class="font-display text-title text-ink mt-8">A word from our sponsors</h2>
          <div class="grid gap-5 mt-5">
            {relatedSponsors.map((s) => (
              <SponsorRead name={s.data.name} read={s.data.read} />
            ))}
          </div>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="mt-16">
          <h2 class="font-display text-title text-ink">Related</h2>
          <div class="grid sm:grid-cols-3 gap-5 mt-5">
            {related.map((v) => (
              <WatchCard
                href={`/watch/${v.data.slug}`}
                title={v.data.title}
                typeLabel={videoTypeLabel[v.data.type]}
                thumbnail={videoThumbnail(v.data)}
                orientation={v.data.orientation}
                nativeAspect={Boolean(v.data.videoWidth && v.data.videoHeight)}
                duration={v.data.duration}
              />
            ))}
          </div>
        </section>
      )
    }

    <nav id="watch-detail-navigation" data-navigation={JSON.stringify(navigation)} data-collection={collectionKey} data-slug={kind === 'video' ? video!.data.slug : entry!.data.slug} class="flex flex-wrap items-center justify-between gap-4 border-t border-line mt-12 pt-6 font-body text-sm text-gold-ink" aria-label="Video navigation">
      <a id="watch-back-link" href={collectionKey === 'deep-cuts' ? '/deep-cuts/' : collectionKey === 'album' ? '/album/' : collectionKey === 'mctrumps' ? '/sponsor-reads/' : `/watch/?collection=${collectionKey}`} class="inline-flex min-h-11 items-center uppercase tracking-[0.1em] hover:opacity-80">← Back to {collectionKey === 'deep-cuts' ? 'Deep Cuts Live' : collectionKey === 'album' ? 'Album' : collectionKey === 'mctrumps' ? 'McTrumps' : collectionKey === 'music-video' ? 'Music Videos' : collectionKey === 'short' ? 'Shorts' : 'Sketches'}</a>
      <div class="flex flex-wrap gap-4">
        <a id="watch-previous-link" hidden class="inline-flex min-h-11 items-center hover:opacity-80">← Previous</a>
        <a id="watch-next-link" hidden class="inline-flex min-h-11 items-center hover:opacity-80">Next →</a>
      </div>
    </nav>
  </article>
</BaseLayout>

<style is:global>
  .watch-detail-title { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.1; }
  .watch-detail-player .video-frame { max-width: min(100%, var(--watch-frame-width)) !important; }
</style>

<script>
  const nav = document.getElementById('watch-detail-navigation')!;
  const items: { slug: string; title: string }[] = JSON.parse(nav.dataset.navigation ?? '[]');
  const collection = nav.dataset.collection!;
  const slug = nav.dataset.slug!;
  const params = new URLSearchParams(window.location.search);
  const currentIndex = items.findIndex((item) => item.slug === slug);
  const actualPage = currentIndex < 0 ? 1 : Math.floor(currentIndex / 12) + 1;
  const requestedPage = params.get('page');
  const page = requestedPage && /^[1-9]\d*$/.test(requestedPage) && Number(requestedPage) === actualPage
    ? Number(requestedPage) : actualPage;
  const pageFor = (index: number) => Math.floor(index / 12) + 1;
  const fromSearch = params.get('from') === 'search';
  const searchContext = new URLSearchParams();
  const query = params.get('q')?.trim().slice(0, 200);
  const knownTypes = new Set(['all', 'album-song', 'music-video', 'deep-cuts', 'sketch', 'short', 'mctrumps', 'image', 'track', 'performance', 'sponsor-read', 'poster', 'bts', 'artwork']);
  const type = params.get('type');
  const searchPage = params.get('searchPage') ?? params.get('page');
  if (query) searchContext.set('q', query);
  if (type && knownTypes.has(type)) searchContext.set('type', type);
  if (searchPage && /^[1-9]\d*$/.test(searchPage) && Number.isSafeInteger(Number(searchPage))) {
    searchContext.set('page', searchPage);
  }
  const collectionHref = collection === 'deep-cuts' ? `/deep-cuts/?page=${page}#video-${slug}`
    : collection === 'album' ? '/album/'
    : collection === 'mctrumps' ? '/sponsor-reads/'
    : `/watch/?collection=${encodeURIComponent(collection)}&page=${page}#video-${slug}`;
  const backLink = document.getElementById('watch-back-link')!;
  if (fromSearch) {
    backLink.setAttribute('href', `/archive/${searchContext.size ? `?${searchContext}` : ''}`);
    backLink.textContent = '← Back to Search';
  } else backLink.setAttribute('href', collectionHref);
  const setAdjacent = (id: string, index: number, label: string) => {
    if (index < 0 || index >= items.length) return;
    const anchor = document.getElementById(id) as HTMLAnchorElement;
    anchor.hidden = false;
    const nextParams = new URLSearchParams({ collection, page: String(pageFor(index)) });
    if (fromSearch) {
      nextParams.set('from', 'search');
      for (const [key, value] of searchContext) nextParams.set(key === 'page' ? 'searchPage' : key, value);
    }
    anchor.href = `/watch/${items[index].slug}/?${nextParams}`;
    anchor.textContent = `${label}: ${items[index].title}`;
  };
  if (currentIndex !== -1) {
    setAdjacent('watch-previous-link', currentIndex - 1, '← Previous');
    setAdjacent('watch-next-link', currentIndex + 1, 'Next →');
  }
</script>
