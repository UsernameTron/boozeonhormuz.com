---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import WatchCard from '../../components/WatchCard.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import { liveVideos, playableTracks, videoTypeLabel, videoThumbnail } from '../../lib/media';

// One grid for everything watchable: media-library videos plus legacy episodes
// of Who the Hell Is Don Biggly? (episodes file under the Sketches filter).
const videos = liveVideos(await getCollection('videos'));
const episodes = (await getCollection('episodes'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const trackTitleById = new Map(
  playableTracks(await getCollection('tracks')).map((t) => [t.id, t.data.title]),
);

const cards = [
  ...videos.map((v) => ({
    href: `/watch/${v.data.slug}`,
    title: v.data.title,
    type: v.data.type,
    typeLabel: videoTypeLabel[v.data.type],
    thumbnail: videoThumbnail(v.data),
    orientation: v.data.orientation,
    duration: v.data.duration,
    trackTitle: v.data.track ? trackTitleById.get(v.data.track.id) : undefined,
    date: v.data.publishDate,
  })),
  ...episodes.map((e) => ({
    href: `/watch/${e.data.slug}`,
    title: e.data.title,
    type: 'sketch',
    typeLabel: 'Episode',
    thumbnail: videoThumbnail(e.data),
    orientation: '16:9' as const,
    duration: undefined,
    trackTitle: undefined,
    date: e.data.publishDate,
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

const filters = [
  { key: 'all', label: 'All' },
  { key: 'music-video', label: 'Music Videos' },
  { key: 'performance', label: 'Performances' },
  { key: 'sketch', label: 'Sketches' },
  { key: 'short', label: 'Shorts' },
];
---

<BaseLayout
  title="Watch — Booze on Hormuz™"
  description="Full music videos, performances, sketches, and shorts from Booze on Hormuz and Who the Hell Is Don Biggly?"
>
  <PageHeader eyebrow="Now screening" title="Watch" />

  <section class="px-6 pb-28 max-w-4xl mx-auto">
    {
      cards.length === 0 ? (
        <Fragment>
          <p class="font-display text-title text-ink max-w-2xl">
            Tremendous premiere. Beautiful catering. Nobody's seen the episodes yet, which many
            people are saying is very smart, very legal, and frankly fantastic. Nobody does
            premieres like me. Believe me.
          </p>
          <div class="mt-8"><YouTubeEmbed id="Za2XII66eHQ" title="Booze on Hormuz" /></div>
        </Fragment>
      ) : (
        <Fragment>
          <div class="archive-filter-list flex flex-wrap gap-2" role="group" aria-label="Filter videos" id="watch-filters">
            {filters.map((f, idx) => (
              <button
                type="button"
                data-filter={f.key}
                aria-pressed={idx === 0 ? 'true' : 'false'}
                class:list={[
                  'font-body text-sm uppercase tracking-[0.1em] px-4 py-2 rounded-sm border transition-colors',
                  'aria-pressed:border-gold aria-pressed:text-gold-ink border-line/60 text-ink-soft hover:text-gold-ink',
                ]}
              >
                {f.label}
              </button>
            ))}
          </div>

          <div class="grid sm:grid-cols-2 gap-6 mt-8" id="watch-grid">
            {cards.map((c) => (
              <div data-type={c.type}>
                <WatchCard
                  href={c.href}
                  title={c.title}
                  typeLabel={c.typeLabel}
                  thumbnail={c.thumbnail}
                  orientation={c.orientation}
                  duration={c.duration}
                  trackTitle={c.trackTitle}
                />
              </div>
            ))}
          </div>

          <p class="hidden font-display text-xl text-ink mt-10" id="watch-empty">
            Nothing in this category yet. The lawyers are reviewing the footage.
          </p>

          <script>
            // Plain client-side filter — the interface behaves totally normally.
            const group = document.getElementById('watch-filters');
            const grid = document.getElementById('watch-grid');
            const empty = document.getElementById('watch-empty');
            group?.addEventListener('click', (ev) => {
              const btn = (ev.target as HTMLElement).closest('button[data-filter]');
              if (!btn || !grid || !empty) return;
              const filter = btn.getAttribute('data-filter');
              group.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
              let visible = 0;
              grid.querySelectorAll<HTMLElement>('[data-type]').forEach((card) => {
                const show = filter === 'all' || card.dataset.type === filter;
                card.style.display = show ? '' : 'none';
                if (show) visible++;
              });
              empty.classList.toggle('hidden', visible > 0);
            });
          </script>
        </Fragment>
      )
    }
  </section>
</BaseLayout>
