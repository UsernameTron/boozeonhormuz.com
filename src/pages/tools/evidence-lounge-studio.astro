---
import BaseLayout from '../../layouts/BaseLayout.astro';
// Advanced workbench. Sandboxed in an iframe (same rationale as broadcast-room).
// The responsive workbench supports phone step navigation and a wide desktop editor.
---

<BaseLayout
  title="Evidence Lounge Prompt Generator — Booze on Hormuz™"
  description="A 20-template Don Biggly prompt workbench with live fillable fields, rendered preview, and custom templates. Copy-ready prompts, no API key."
>
  <div class="px-4 sm:px-6 pt-6 sm:pt-10 pb-5 max-w-[1500px] mx-auto font-body">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="text-sm text-ink-soft">
      <a href="/tools" class="hover:text-gold-ink">Creative Arsenal</a>
      <span class="mx-2 text-line">/</span>
      <span class="text-ink">Evidence Lounge</span>
    </nav>

    <div class="mt-4 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
      <h1 class="font-display text-title text-ink">Evidence Lounge Prompt Generator</h1>
      <a href="/tools/broadcast-room" class="text-sm uppercase tracking-[0.08em] text-gold-ink hover:opacity-80">
        Switch to Broadcast Room &rarr;
      </a>
    </div>

    <p class="mt-3 text-ink-soft max-w-2xl">
      Pick a template, fill the fields, render, and copy the prompt into Suno, Sora, Veo,
      Gemini, ChatGPT, or Claude. This builds <strong class="text-ink">copy-ready prompts</strong>,
      not live AI generations — nothing leaves your browser.
    </p>


  </div>

  <div class="px-2 sm:px-6 pb-12 max-w-[1500px] mx-auto">
    <a href="/apps/evidence-lounge-studio.html" target="_blank" rel="noopener" class="inline-block text-sm text-gold-ink mb-3 py-2">Open full workspace in a new tab ↗</a>
    <iframe
      src="/apps/evidence-lounge-studio.html"
      title="Evidence Lounge Prompt Generator"
      class="w-full h-[85dvh] min-h-[560px] rounded-lg border border-line bg-charcoal"
      loading="eager"
    ></iframe>
    <p class="mt-3 text-xs text-ink-soft/80">
      Export Project keeps your editor, variables and custom templates. Imports preview before
      applying, and device saving is optional. Nothing is stored on a server.
      <a href="/tools/safety" class="text-gold-ink hover:opacity-80">Satire &amp; safety guidelines</a>.
    </p>
  </div>
</BaseLayout>
