---
import BaseLayout from '../../layouts/BaseLayout.astro';
// Featured tool. The generator is a self-contained app sandboxed in an iframe so its
// own CSS reset + token set can't collide with the site's Tailwind @theme. BaseLayout
// supplies Nav + Footer + the global parody disclaimer around it.
---

<BaseLayout
  title="Biggly Broadcast Pack Generator — Booze on Hormuz™"
  description="One concept in, a full Don Biggly content kit out: Suno lyrics, storyboard, Sora/Veo prompts, image prompts, and a launch pack. Copy-ready, no API key."
>
  <div class="px-6 pt-16 pb-6 max-w-5xl mx-auto font-body">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="text-sm text-ink-soft">
      <a href="/tools" class="hover:text-gold-ink">Creative Arsenal</a>
      <span class="mx-2 text-line">/</span>
      <span class="text-ink">Broadcast Room</span>
    </nav>

    <div class="mt-4 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
      <h1 class="font-display text-title text-ink">Biggly Broadcast Pack Generator</h1>
      <a href="/tools/evidence-lounge-studio" class="text-sm uppercase tracking-[0.08em] text-gold-ink hover:opacity-80">
        Switch to Evidence Lounge &rarr;
      </a>
    </div>

    <p class="mt-3 text-ink-soft max-w-2xl">
      Fill the brief, hit generate, then copy the pack into Suno, Sora, Veo, Gemini, ChatGPT,
      or Claude. This builds <strong class="text-ink">copy-ready prompts</strong>, not live AI
      generations — nothing leaves your browser.
    </p>
  </div>

  <div class="px-6 pb-20 max-w-5xl mx-auto">
    <iframe
      src="/apps/broadcast-room.html"
      title="Biggly Broadcast Pack Generator"
      class="w-full h-[88vh] min-h-[700px] rounded-lg border border-line bg-charcoal"
      loading="eager"
    ></iframe>
    <p class="mt-3 text-xs text-ink-soft/80">
      Tool runs entirely in this frame. Use its Export button to save your brief as a file —
      nothing is stored on a server. <a href="/tools/safety" class="text-gold-ink hover:opacity-80">Satire &amp; safety guidelines</a>.
    </p>
  </div>
</BaseLayout>
