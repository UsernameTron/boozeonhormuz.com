---
// Self-hosted variable fonts (Fontsource ships @font-face with font-display: swap)
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import frauncesFont from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  preloadFonts?: boolean;
}

const {
  title = 'Booze on Hormuz',
  description = 'Booze on Hormuz.',
  ogImage: customOgImage,
  ogImageWidth: customOgImageWidth,
  ogImageHeight: customOgImageHeight,
  preloadFonts = false,
} = Astro.props;

// Absolute canonical + OG image URLs (crawlers require absolute).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const OG_ROUTES = new Set(['album', 'listen', 'archive', 'studio', 'press', 'play', 'evidence-lounge', 'watch', 'products', 'sponsor-reads', 'quotes', 'about', 'legal']);
const slug = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const ogImage = new URL(customOgImage ?? (OG_ROUTES.has(slug) ? `/open-graph/${slug}.png` : '/og-home.jpg'), Astro.site).href;
const ogImageWidth = customOgImage ? customOgImageWidth : 1200;
const ogImageHeight = customOgImage ? customOgImageHeight : 630;

// Cloudflare Web Analytics — a PUBLIC beacon id (safe to commit), no cookies.
// TODO(owner): create at dash.cloudflare.com → Web Analytics → add
// boozeonhormuz.com → paste the token below to enable. Empty = no script.
const CF_BEACON_TOKEN = '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {preloadFonts && <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin="anonymous" />}
    {preloadFonts && <link rel="preload" href={frauncesFont} as="font" type="font/woff2" crossorigin="anonymous" />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:site_name" content="Booze on Hormuz" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      CF_BEACON_TOKEN && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token":"${CF_BEACON_TOKEN}"}`}
        />
      )
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Nav />

    <main id="main-content" tabindex="-1" class="flex-1 min-w-0">
      <slot />
    </main>

    <Footer />
  </body>
</html>
