---
interface Props {
  name: string;
  read: string;
  episodeSlug?: string;
}
const { name, read, episodeSlug } = Astro.props;
---

<article class="border border-line p-5">
  <p class="font-body text-eyebrow uppercase text-gold-ink">A word from our sponsor</p>
  <h3 class="font-display text-2xl text-ink mt-2">{name}</h3>
  <p class="font-body text-ink-soft mt-3 max-w-prose">{read}</p>
  {
    episodeSlug && (
      <a
        href={`/watch/${episodeSlug}`}
        class="inline-block font-body text-sm uppercase tracking-[0.1em] text-stamp mt-4 hover:opacity-80"
      >
        As heard on this episode &rarr;
      </a>
    )
  }
</article>
