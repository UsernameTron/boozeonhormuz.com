---
import type { QueueTrack } from '../lib/listening';
import { listeningSourceVersion } from '../lib/listening-source';
import { mediaImageSource, responsiveImage } from '../lib/responsive-media';
interface Props { queue: QueueTrack[] }
const { queue } = Astro.props;
const displayQueue = queue.map((track) => {
  const cover = mediaImageSource(track.cover);
  const thumbnail = responsiveImage(cover).srcset?.split(',')[0].trim().split(' ')[0];
  return { ...track, sourceVersion: listeningSourceVersion(track.source), cover: thumbnail || cover };
});
---
<div class="listening-room" data-listening-room data-queue={JSON.stringify(displayQueue)}>
  <div class="queue-tools font-body" data-queue-tools hidden>
    <div class="queue-heading">
      <button type="button" class="listening-button" data-play-all>Play all {queue.length} {queue.length === 1 ? 'track' : 'tracks'}</button>
      <p>Featured tracks first. Playback stays on this page.</p>
    </div>
    <details class="resume-settings">
      <summary>Playback &amp; device settings</summary>
      <label><input type="checkbox" data-resume-opt-in /> Remember my listening position on this device</label>
      <p>Optional. Saves one track and its position as you listen. Returning here never starts audio automatically.</p>
      <button type="button" class="listening-button secondary" data-restore hidden>Restore saved position</button>
      <button type="button" class="listening-button secondary" data-clear-resume>Clear saved position &amp; turn off remembering</button>
      <p data-storage-status role="status"></p>
    </details>
  </div>
  <slot />
  <section class="mini-player font-body" data-mini-player aria-label="Listening controls" hidden>
    <div class="now-playing">
      <img data-now-art alt="" width="56" height="56" hidden />
      <div><p class="now-label">On the record</p><a data-now-link class="now-title" href="/listen">Choose a track</a></div>
    </div>
    <div class="transport" role="group" aria-label="Track playback">
      <button type="button" class="listening-button secondary" data-previous disabled>Previous</button>
      <button type="button" class="listening-button" data-toggle>Play</button>
      <button type="button" class="listening-button secondary" data-next disabled>Next</button>
    </div>
    <div class="playback-progress">
      <label for="listening-seek" class="visually-hidden">Playback position</label>
      <input id="listening-seek" data-seek type="range" min="0" max="100" value="0" step="0.1" disabled />
      <span data-time>0:00 / 0:00</span>
    </div>
    <p class="playback-status" data-playback-status role="status">Ready when you are. Native players above remain available.</p>
  </section>
</div>

<style>
  [hidden] { display: none !important; }
  .queue-tools { margin-bottom: 1.5rem; }
  .queue-heading { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; }
  .queue-tools p { color: var(--color-ink-soft); font-size: .85rem; }
  .resume-settings { margin-top: .75rem; font-size: .85rem; }
  .resume-settings summary { cursor: pointer; padding: .75rem 0; color: var(--color-gold-ink); }
  .resume-settings label { display: flex; align-items: flex-start; gap: .5rem; margin: .5rem 0; }
  .resume-settings input { width: 20px; height: 20px; flex-shrink: 0; accent-color: var(--color-gold-ink); }
  .resume-settings .listening-button { margin-top: .75rem; }
  .resume-settings p { margin-top: .5rem; }
  .listening-button { min-height: 44px; padding: .6rem .85rem; border: 1px solid var(--color-gold-ink); border-radius: .5rem; background: var(--color-gold-ink); color: var(--color-paper); font-size: .85rem; font-weight: 600; line-height: 1.3; cursor: pointer; min-width: 0; overflow-wrap: anywhere; }
  .listening-button.secondary { background: transparent; color: var(--color-gold-ink); }
  .listening-button:disabled { opacity: .45; cursor: default; }
  button:focus-visible, a:focus-visible, summary:focus-visible, input:focus-visible { outline: 3px solid var(--color-ink); outline-offset: 3px; }
  .mini-player { display: grid; gap: .75rem 1rem; margin-top: 1.25rem; padding: 1rem; border: 1px solid var(--color-line); border-radius: .75rem; background: var(--color-charcoal); box-shadow: 0 8px 30px #0008; z-index: 15; }
  .now-playing { display: flex; align-items: center; gap: .75rem; min-width: 0; }
  .now-playing > div { min-width: 0; }
  .now-playing img { width: 56px; height: 56px; object-fit: contain; border-radius: .3rem; background: var(--color-paper); }
  .now-label { color: var(--color-ink-soft); font-size: .7rem; text-transform: uppercase; letter-spacing: .1em; }
  .now-title { color: var(--color-ink); font-weight: 600; font-size: 1rem; overflow-wrap: anywhere; text-decoration: underline; text-underline-offset: 3px; }
  .transport { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .4rem; }
  .transport .listening-button { padding-inline: .4rem; }
  .playback-progress { display: flex; align-items: center; gap: .75rem; min-width: 0; }
  .playback-progress input { min-width: 0; flex: 1; accent-color: var(--color-gold-ink); min-height: 32px; }
  .playback-progress span { flex-shrink: 0; color: var(--color-ink-soft); font-size: .75rem; font-variant-numeric: tabular-nums; }
  .playback-status { color: var(--color-ink-soft); font-size: .8rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (min-width: 1024px) {
    .listening-room { display: grid; grid-template-columns: minmax(0, 1fr) 16rem; gap: 1.25rem; align-items: start; }
    .queue-tools { grid-column: 1 / -1; margin-bottom: 0; }
    .mini-player { grid-column: 2; grid-row: 2; margin-top: 0; }
  }
  @media (min-width: 1024px) and (min-height: 700px) {
    .mini-player { position: sticky; top: max(1rem, env(safe-area-inset-top)); }
  }
</style>

<script>
  import { initializeListeningRoom } from '../scripts/listening-controller';
  document.querySelectorAll<HTMLElement>('[data-listening-room]').forEach(initializeListeningRoom);
</script>
