---
interface Props {
  text: string;
  context: string;
}
const { text, context } = Astro.props;
---

<figure class="border border-line card-marble p-6 sm:p-8">
  <figcaption class="font-body text-sm text-gold-ink mb-4">{context}</figcaption>
  <blockquote class="font-display text-xl sm:text-2xl leading-relaxed text-ink">&ldquo;{text}&rdquo;</blockquote>
</figure>
