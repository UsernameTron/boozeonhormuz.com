---
const columns = [
  {
    heading: 'The Work',
    links: [
      { href: '/watch', label: 'Watch' },
      { href: '/album', label: 'Album' },
      { href: '/gallery', label: 'Gallery' },
    ],
  },
  {
    heading: 'The World',
    links: [
      { href: '/explore', label: 'Explore Don’s world' },
      { href: '/about', label: 'About Don' },
    ],
  },
  {
    heading: 'Studio & information',
    links: [
      { href: '/studio', label: 'Studio' },
      { href: '/tools', label: 'Creative tools' },
      { href: '/archive', label: 'Search' },
      { href: '/legal', label: 'Legal' },
    ],
  },
];
---

<footer class="px-6 py-8 mt-16 border-t border-line text-sm text-ink-soft max-w-4xl mx-auto">
  <nav aria-label="Footer" class="grid gap-8 pb-8 border-b border-line/40" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr))">
    {
      columns.map((col) => (
        <div class="min-w-0">
          <p class="font-body text-eyebrow uppercase text-gold-ink">{col.heading}</p>
          <ul class="mt-3 space-y-2">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="hover:text-gold-ink transition-colors">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>

  <p class="mt-8">
    <strong>Very Legal Disclaimer:</strong>
  </p>
  <p class="mt-2">
    This is parody. Booze on Hormuz and Don Biggly are fictional satire, not news, real quotes,
    leaks, policy, or confessions. Names, characters, products, and events appear as parody and
    transformative commentary. No affiliation, endorsement, sponsorship, official statement, or
    factual claim is intended or implied. My counsel reviewed it. Reviewed. He made that word very large.
  </p>
  <p class="mt-3">
    <a href="/legal" class="uppercase tracking-[0.1em] text-gold-ink hover:opacity-80">
      Read the full Very Legal Disclaimer &rarr;
    </a>
  </p>
</footer>
