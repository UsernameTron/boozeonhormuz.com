---
interface Props {
  eyebrow?: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---

<header class="px-6 pt-8 pb-6 md:pt-10 md:pb-6 max-w-4xl mx-auto">
  {eyebrow && <p class="font-body text-eyebrow uppercase text-gold-ink">{eyebrow}</p>}
  <h1 class="page-title font-display text-ink mt-3">{title}</h1>
  <hr class="mt-5 border-0 border-t brass-rule" />
</header>

<style>
  .page-title { font-size: clamp(2rem, 5vw, 3.25rem); line-height: 1.12; letter-spacing: -.02em; }
</style>
